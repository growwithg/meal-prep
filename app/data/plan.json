      "id": "pollock-white-bean-stew",
      "name": "Alaska Pollock & White Bean Stew with Barley",
      "track": "stovetop",
      "protein_source": "fish",
      "active_min": 20,
      "total_min": 45,
      "reheat": "Microwave 2:00 at 600 W. Low power — high power turns the fish rubbery.",
