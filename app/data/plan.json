      "id": "turkey-meatballs-fusilli",
      "name": "Turkey Meatballs in Tomato Sauce with Fusilli",
      "track": "oven",
      "protein_source": "turkey",
      "active_min": 25,
      "total_min": 45,
      "reheat": "Microwave 2:45 at 800 W.",
      "cold_ok": false,
